<!DOCTYPE html>
<html xmlns:th="http>//www.thymeleaf.org">

</html>

<head>
	<meta charset="UTF-8" />
	<title>Enviar parámetros del request HTTP GET - URL</title>
</head>

<body>
	<h1>Enviar parámetros del request HTTP GET - URL</h1>
	<ul>
		<li><a th:href="@{/params/string(texto='Hola Juan')}">/params/string?texto= Hola Juan</a></li>
		<li><a th:href="@{/params/string(texto='Que tal Andrés!')}">/params/string?texto= Que tal Andrés</a></li>
		<li><a th:href="@{/params/mix-params(saludo='Que tal Andrés!')}">/params/string?texto= Que tal Andrés</a></li>
	</ul>
</body>

</html>